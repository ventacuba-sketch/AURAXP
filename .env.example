# Copiar a `.env` y completar con los valores reales de tu proyecto.
# `.env` está en .gitignore — nunca se commitea.
#
# EXPO_PUBLIC_* son las únicas variables que Expo mete en el bundle del
# cliente — por eso solo van acá el URL del proyecto y la clave "anon"
# (pública por diseño). La service_role key y la key de Gemini NUNCA van
# en este archivo ni en el cliente: viven como secrets de Supabase, y
# solo las usan los Edge Functions.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clave PÚBLICA de VAPID (Web Push, ver pushService.ts) -- no es secreta
# por definición (el navegador la necesita para pedir la suscripción),
# pero sin ella `isPushSupported()` da `false` en toda la app (la
# sección de notificaciones del Perfil queda en "NO DISPONIBLES"). Debe
# ser EXACTAMENTE la misma clave pública configurada como secret
# VAPID_PUBLIC_KEY de la Edge Function `send-push` en Supabase -- son un
# par, no dos valores independientes.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# AURA LIVE (ver docs/aura-live.md) -- ambas son seguras de exponer en el
# cliente: la URL del servidor de LiveKit es pública por diseño (el
# propio navegador la necesita para conectar), y el flag solo controla
# UI -- la seguridad real (quién puede transmitir, qué token recibe cada
# quien) vive 100% server-side y no depende de este valor. NUNCA pongas
# LIVEKIT_API_SECRET acá ni en ningún EXPO_PUBLIC_* -- ese vive solo como
# secret de las Edge Functions livekit-token/livekit-webhook.
EXPO_PUBLIC_LIVEKIT_URL=
# 'true' para mostrar la UI de AURA LIVE (Crear LIVE, tarjeta "EN VIVO
# AHORA" en el Chat); cualquier otro valor (incluido vacío) la mantiene
# oculta. Útil mientras LiveKit todavía no está configurado -- ver sección
# Configuración manual en docs/aura-live.md.
EXPO_PUBLIC_AURA_LIVE_ENABLED=
