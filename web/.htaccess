# AURAXP web (auravs.app) -- Apache config for the Expo web export.
# Copied into dist/ by .github/workflows/deploy-web.yml on every deploy
# (the export command regenerates dist/ from scratch each time, so this
# file can't just live inside dist/ in the repo -- it's not there).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # SPA fallback: React Navigation resolves screens client-side. Any
  # request that isn't an existing file or directory (a refresh on a
  # deep screen, or a direct hit on a route like /c/:token) must fall
  # through to index.html so the app can boot and route it itself --
  # otherwise Apache 404s on anything but the exact root URL.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html's filename never changes between deploys, so it's the one
  # file Safari could keep serving stale after a push. Force revalidation
  # on every load.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Everything under _expo/static/** (JS bundles, etc.) is content-hashed
  # by Metro -- a code change always produces a new filename, so the old
  # one can be cached indefinitely without ever serving stale content.
  <FilesMatch "\.(js|css|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images/icons: long cache is safe too, but not marked immutable since
  # some (favicon.ico) aren't hash-named.
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
